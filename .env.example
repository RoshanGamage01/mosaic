# Where Mosaic keeps its own workspace file (connections, reports, dashboards).
# Defaults to ./.mosaic
# MOSAIC_DATA_DIR=/var/lib/mosaic

# Keep the workspace in MongoDB instead of a file. Use this when Mosaic runs in
# a container without a mounted volume, where a local file would not survive a
# restart. This is Mosaic's own storage, not a database you report on.
# MOSAIC_STORE_URI=mongodb://127.0.0.1:27017
# MOSAIC_STORE_DB=mosaic
# MOSAIC_STORE_COLLECTION=mosaic_workspace

# Optional sample database. When set on a brand new install, Mosaic registers
# and scans it automatically so the first screen is not empty.
# MOSAIC_DEMO_URI=mongodb://127.0.0.1:47017
# MOSAIC_DEMO_DB=northwind_trading
# MOSAIC_DEMO_NAME=Northwind Trading (sample)

# How money and dates are displayed.
# NEXT_PUBLIC_MOSAIC_CURRENCY=USD
# NEXT_PUBLIC_MOSAIC_LOCALE=en-US
